# 复制为项目根目录的 .env 后按需修改。
APP_NAME="数据处理平台"
APP_VERSION=0.1.0
# 可选值：development、test、production
APP_ENV=development
DEBUG=false
# 可选值：DEBUG、INFO、WARNING、ERROR、CRITICAL
LOG_LEVEL=INFO

# MySQL 连接配置，账号和密码需要在本机填写。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=data_processing_platform
MYSQL_USER=""
MYSQL_PASSWORD=""
